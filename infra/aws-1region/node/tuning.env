# Latency tuning, read by cdcctl.sh (`tune` changes it on a node until the next bundle update).
# Debezium waits up to POLL_INTERVAL_MS twice per event (idle sleep + queue hand-off).
# Measured 2026-11-22: defaults 500/0.2 -> p50 628 ms; 50/0.02 -> p50 80 ms.
POLL_INTERVAL_MS=50
# Fixed wait before Debezium restarts after a lost database connection (default 10000)
RETRIABLE_WAIT_MS=1000
# How often Debezium reports its position to Postgres (default 10000)
STATUS_INTERVAL_MS=1000
# Longest the worker waits to fill a batch (default 0.2)
CONSUME_TIMEOUT_S=0.02
